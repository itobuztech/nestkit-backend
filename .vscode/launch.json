{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Jest Tests",
      "type": "node",
      "request": "launch",
      "args": [
        "${fileBasename}",
        "--config",
        "${workspaceRoot}/e2e/jest.config.ts"
      ],
      "runtimeArgs": [
        "--inspect-brk",
        "${workspaceRoot}/e2e/node_modules/.bin/jest",
        "--runInBand"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceRoot}/e2e"
    }
  ]
}